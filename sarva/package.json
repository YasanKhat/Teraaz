{
  "name": "sarva-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "سروا — نسخهٔ دسکتاپ آفلاین؛ وزن‌یاب، درسنامه، عروض سماعی، بازی‌های ادبی و آزمون‌ها، بی‌نیاز از اینترنت",
  "main": "./out/main/index.js",
  "author": "YasanKhat",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.13.0",
    "keen-slider": "^6.8.6",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "nprogress": "^0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.3.0",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "wavesurfer.js": "^7.9.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.19.1",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
